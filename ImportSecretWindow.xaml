<Window x:Class="WinOtp.ImportSecretWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from secret"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16" MinWidth="320">
        <TextBlock Text="Account name" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,10" />

        <TextBlock Text="Secret (Base32)" Margin="0,0,0,4" />
        <TextBox x:Name="SecretBox" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Digits" Margin="0,0,0,4" />
                <TextBox x:Name="DigitsBox" Text="6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Period (seconds)" Margin="0,0,0,4" />
                <TextBox x:Name="PeriodBox" Text="30" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Import" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Import_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
