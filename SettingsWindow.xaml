<Window x:Class="WinOtp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Always on top" FontWeight="SemiBold" />
                <TextBlock Text="Keep WinOTP above other windows"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox x:Name="AlwaysOnTopCheck" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <Separator Margin="0,4" />

        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Minimize to tray" FontWeight="SemiBold" />
                <TextBlock Text="Hide to tray instead of exiting"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox x:Name="MinimizeToTrayCheck" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <StackPanel x:Name="HintsPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <Separator Margin="0,0,0,8" />
            <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Ctrl+1…9 — copy OTP for account #n (filtered list)"
                       Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="Ctrl+F — open search"
                       Foreground="Gray" FontSize="12" Margin="0,4,0,0" />
            <TextBlock Text="Esc — close search / cancel edit / exit delete mode"
                       Foreground="Gray" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="HintsButton"
                    Content="?"
                    Width="28" Height="28"
                    Margin="0,0,8,0"
                    ToolTip="Keyboard shortcuts"
                    Click="HintsButton_Click" />
            <Button Content="Close"
                    Width="72"
                    IsDefault="True"
                    Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
