<Window x:Class="WinOtp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOTP" Height="220" Width="380"
        MinHeight="160" MinWidth="320"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CopyButton" TargetType="Button">
            <!-- Fixed width so "Copy" / "Copied!" do not shift the row. -->
            <Setter Property="Width" Value="76" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ImportButton"
                        Content="Import"
                        Style="{StaticResource ToolbarButton}"
                        Click="ImportButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="From QR…" Click="ImportQr_Click" />
                            <MenuItem Header="From secret…" Click="ImportSecret_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="DeleteButton"
                        Content="Delete"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Select accounts to delete"
                        Click="Delete_Click" />
                <Button x:Name="CancelDeleteButton"
                        Content="Cancel"
                        Style="{StaticResource ToolbarButton}"
                        Visibility="Collapsed"
                        Click="CancelDelete_Click" />
                <Button x:Name="SearchToggleButton"
                        Content="⌕"
                        Width="28" Height="28"
                        Margin="0,0,6,0"
                        Padding="0"
                        FontSize="14"
                        ToolTip="Search accounts"
                        Click="SearchToggle_Click" />
            </StackPanel>
            <Button x:Name="SettingsButton"
                    Content="⚙"
                    Width="28" Height="28"
                    HorizontalAlignment="Right"
                    Padding="0"
                    ToolTip="Settings"
                    Click="SettingsButton_Click" />
        </Grid>

        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 Margin="8,0,8,6"
                 Visibility="Collapsed"
                 KeyDown="SearchBox_KeyDown"
                 TextChanged="SearchBox_TextChanged" />

        <!-- Account list -->
        <Grid Grid.Row="2">
            <ListBox x:Name="AccountsList"
                     BorderThickness="0"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch"
                     Background="Transparent"
                     DragOver="AccountsList_DragOver"
                     Drop="AccountsList_Drop">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename"
                                              Click="RenameMenu_Click"
                                              Tag="{Binding}" />
                                    <MenuItem Header="Delete…"
                                              Click="RowDeleteMenu_Click"
                                              Tag="{Binding}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Drag handle (~10px) -->
                            <Border Grid.Column="0"
                                    Width="10"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Cursor="SizeAll"
                                    Background="Transparent"
                                    Tag="{Binding}"
                                    PreviewMouseLeftButtonDown="DragHandle_MouseDown"
                                    PreviewMouseMove="DragHandle_MouseMove"
                                    Visibility="{Binding ShowDragHandle, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⋮⋮"
                                           FontSize="9"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Selection checkbox (delete mode) -->
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}" />

                            <!-- Account name (rename via context menu only — avoids accidental double-click edit) -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="{Binding}"
                                         Padding="0"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         KeyDown="RenameBox_KeyDown"
                                         LostFocus="RenameBox_LostFocus"
                                         IsVisibleChanged="RenameBox_IsVisibleChanged"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- OTP — click to copy -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Code}"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       FontFamily="Consolas"
                                       FontSize="16"
                                       Cursor="Hand"
                                       ToolTip="Click to copy"
                                       Tag="{Binding}"
                                       MouseLeftButtonUp="Code_Click" />

                            <TextBlock Grid.Column="4"
                                       Text="{Binding CountdownText}"
                                       Foreground="{Binding CountdownBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       FontSize="12" />

                            <Button Grid.Column="5"
                                    Content="{Binding CopyButtonText}"
                                    Style="{StaticResource CopyButton}"
                                    Click="Copy_Click"
                                    Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyStateText"
                       Text="No accounts yet.&#x0a;Use Import to add one from a QR code or secret."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="Gray"
                       FontSize="13"
                       LineHeight="22"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <TextBlock x:Name="NoMatchText"
                       Text="No accounts match your search."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       FontSize="13"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
